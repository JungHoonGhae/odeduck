{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "schedule": ["* 9-11 * * 1"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies", "needs-triage"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps:",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    { "matchManagers": ["gomod"], "matchUpdateTypes": ["minor", "patch"], "groupName": "go minor and patch" },
    { "matchManagers": ["gomod"], "matchPackageNames": ["golang.org/x/**"], "matchUpdateTypes": ["minor", "patch"], "groupName": "golang maintenance" },
    { "matchManagers": ["github-actions"], "matchUpdateTypes": ["minor", "patch"], "groupName": "actions minor and patch" }
  ]
}
